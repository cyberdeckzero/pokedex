{
  "name": "mini-pokedex",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1 --port 4200",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "mock": "node scripts/mock-server.cjs",
    "format": "prettier --write src e2e playwright.config.ts scripts mock *.json *.cjs *.md",
    "format:check": "prettier --check src e2e playwright.config.ts scripts mock *.json *.cjs *.md",
    "check:mock": "node scripts/check-mock.mjs",
    "prepare": "node scripts/setup-hooks.mjs",
    "check:poke": "node scripts/check-poke.mjs",
    "test:e2e": "playwright test",
    "check:mock-persistence": "node scripts/check-mock-persistence.mjs"
  },
  "private": true,
  "packageManager": "npm@11.6.4",
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "chart.js": "4.6.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.29",
    "@angular/cli": "21.2.29",
    "@angular/compiler-cli": "21.2.26",
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "@playwright/test": "1.65.0",
    "cors": "2.8.6",
    "express": "5.3.0",
    "jsdom": "27.4.0",
    "json-graphql-server": "2.4.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0",
    "npm": ">=11.6.4"
  }
}
